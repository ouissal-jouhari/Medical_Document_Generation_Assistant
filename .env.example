# Copier vers .env (jamais committé). Valeurs d'exemple uniquement, aucun secret réel.
# Mots de passe : lettres, chiffres et tirets seulement (utilisés dans des URL et du SQL).
APP_ENV=dev
SITE_ADDRESS=localhost
SITE_URL=https://localhost
MAX_REQUEST_BYTES=20971520
LOG_RETENTION_DAYS=30

# PostgreSQL : propriétaire (migrations), rôle applicatif et rôle de purge (voir docs/adr/0006).
POSTGRES_USER=xeleron
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=xeleron
APP_DB_PASSWORD=change-me-app
PURGE_DB_PASSWORD=change-me-purge

# Keycloak.
KEYCLOAK_DB_PASSWORD=change-me-keycloak
KEYCLOAK_ADMIN_PASSWORD=change-me-admin
# Utilisateur de test du realm (TOTP pré-enregistré). À changer ou supprimer hors test.
KC_TEST_USER_PASSWORD=change-me-test-user
KC_TEST_USER_TOTP_SECRET=ChangeMeTotpSecret01

# Chiffrement au repos : chiffrement de volume côté hôte (voir docs/adr/0003). Aucune clé ici.
