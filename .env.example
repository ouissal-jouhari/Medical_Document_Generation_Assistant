# Copier vers .env (jamais committé). Valeurs d'exemple uniquement, aucun secret réel.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://xeleron:change-me@db:5432/xeleron
POSTGRES_USER=xeleron
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xeleron
LOG_DIR=/var/log/xeleron
LOG_RETENTION_DAYS=30
MAX_REQUEST_BYTES=20971520
# Chiffrement au repos : chiffrement de volume côté hôte (voir docs/adr/0003). Aucune clé ici.
SITE_ADDRESS=localhost
