{$SITE_ADDRESS:localhost} {
	encode gzip

	request_body {
		max_size {$MAX_REQUEST_BYTES:53477376}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Keycloak pose ses propres en-têtes (CSP, X-Frame-Options) : on ne les écrase pas.
	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	# Délai aligné sur le plus long traitement serveur (extraction 300 s, génération 150 s) + marge.
	handle_path /api/* {
		header {
			X-Frame-Options "DENY"
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		}
		reverse_proxy backend:8000 {
			transport http {
				response_header_timeout 330s
				read_timeout 330s
			}
		}
	}

	handle {
		header {
			X-Frame-Options "DENY"
			Content-Security-Policy "default-src 'self'; connect-src 'self'; frame-ancestors 'none'"
		}
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
